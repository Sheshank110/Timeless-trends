# ============================================
# TIMELESS TRENDS — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/timeless-trends?retryWrites=true&w=majority

# ---- JWT ----
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Email (Nodemailer SMTP) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ---- WhatsApp ----
WHATSAPP_NUMBER=919999999999

# ---- AI (OpenAI / Gemini) ----
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key

# ---- Client ----
CLIENT_URL=http://localhost:5173
